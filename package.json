{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run build && npm test && for f in api/*.js; do node --check \"$f\" || exit 1; done && node --check app.js && echo 'build + tests + api syntax OK'",
    "serve": "npx http-server -p 8080 -c-1 .",
    "test": "node --test --test-force-exit test/*.test.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.5.1",
    "mcp-handler": "^1.0.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
