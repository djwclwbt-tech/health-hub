# Copy of the Vercel env var names. Fill with `vercel env pull .env.local`.
# Never commit real values. See CLAUDE.md → Environment variables.

# AI (weekly analysis, body-comp photos)
ANTHROPIC_API_KEY=
AI_MODEL=

# Supabase (SUPABASE_KEY or SUPABASE_ANON_KEY)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Write endpoints
UPDATE_TOKEN=
SYNC_TOKEN=
MCP_TOKEN=
NOTIFY_TOKEN=

# Oura recovery sync
OURA_PAT=
OURA_SYNC_SECRET=

# Cronometer nutrition sync (Gold account required)
CRONOMETER_USERNAME=
CRONOMETER_PASSWORD=
CRONOMETER_SYNC_SECRET=

# Web Push for rest-timer notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Local scripts only (scripts/push-update.sh); defaults to the live app
HEALTH_HUB_URL=
